# Supabase - get these from your project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HubSpot OAuth (from developer portal → your app → Auth tab)
# HUBSPOT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# HUBSPOT_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# HUBSPOT_REDIRECT_URI is optional on Vercel (auto-derived from VERCEL_URL)
# For local dev: HUBSPOT_REDIRECT_URI=http://localhost:3000/api/integrations/hubspot/callback
