## 5. CSS Animations (All Keyframes)

All keyframes are defined in `src/index.css` inside `@layer utilities`:

```css
@keyframes confetti-enhanced {
  0% { transform: translateY(-20vh) rotate(0deg) scale(1); opacity: 1; }
  25% { transform: translateY(20vh) rotate(180deg) scale(1.2) translateX(20px); }
  50% { transform: translateY(50vh) rotate(360deg) scale(0.8) translateX(-20px); }
  75% { transform: translateY(75vh) rotate(540deg) scale(1.1) translateX(10px); opacity: 0.8; }
  100% { transform: translateY(110vh) rotate(720deg) scale(0.5) translateX(-10px); opacity: 0; }
}

@keyframes celebration-entrance {
  0% { transform: scale(0.3) translateY(50px); opacity: 0; }
  50% { transform: scale(1.1) translateY(-10px); }
  70% { transform: scale(0.95) translateY(5px); }
  100% { transform: scale(1) translateY(0); opacity: 1; }
}

@keyframes photo-bounce {
  0% { transform: scale(0) translateY(30px); opacity: 0; }
  60% { transform: scale(1.15) translateY(-15px); }
  80% { transform: scale(0.95) translateY(5px); }
  100% { transform: scale(1) translateY(0); opacity: 1; }
}

@keyframes title-glow {
  0%, 100% { text-shadow: 0 0 30px hsl(38 95% 55% / 0.5), 0 0 60px hsl(38 95% 55% / 0.3); filter: brightness(1); }
  50% { text-shadow: 0 0 50px hsl(38 95% 55% / 0.8), 0 0 100px hsl(38 95% 55% / 0.5); filter: brightness(1.2); }
}

@keyframes gif-entrance {
  0% { transform: scale(0.5) translateY(30px); opacity: 0; }
  100% { transform: scale(1) translateY(0); opacity: 1; }
}

@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 20px hsl(var(--primary) / 0.3); }
  50% { box-shadow: 0 0 40px hsl(var(--primary) / 0.6); }
}

@keyframes epic-shake {
  0%, 100% { transform: translateX(0); }
  10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
  20%, 40%, 60%, 80% { transform: translateX(5px); }
}

@keyframes epic-glow {
  0%, 100% { box-shadow: 0 0 40px rgba(251,191,36,0.4), 0 0 80px rgba(251,191,36,0.3), 0 0 120px rgba(251,191,36,0.2); }
  50% { box-shadow: 0 0 60px rgba(251,191,36,0.6), 0 0 120px rgba(251,191,36,0.5), 0 0 180px rgba(251,191,36,0.4); }
}

@keyframes slide-up-card {
  0% { opacity: 0; transform: translateY(40px); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes fade-card-loop {
  0%, 15% { opacity: 1; }
  20%, 45% { opacity: 0.3; }
  50%, 100% { opacity: 1; }
}

@keyframes celebration-mockup-cycle {
  0%, 15% { opacity: 0; transform: scale(0.8); }
  25%, 55% { opacity: 1; transform: scale(1); }
  65%, 100% { opacity: 0; transform: scale(0.8); }
}

@keyframes float-particle {
  0% { transform: translateY(0) translateX(0); opacity: 0; }
  10% { opacity: 1; }
  50% { transform: translateY(-50vh) translateX(15px); }
  90% { opacity: 1; }
  100% { transform: translateY(-100vh) translateX(0); opacity: 0; }
}

@keyframes slide-left-loop {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

@keyframes count-up-glow {
  0% { opacity: 0.5; transform: scale(0.95); }
  50% { opacity: 1; transform: scale(1.05); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes bounce-dot {
  0%, 80%, 100% { transform: translateY(0); }
  40% { transform: translateY(-6px); }
}

@keyframes equalizer-bar {
  0%, 100% { height: 20%; }
  25% { height: 80%; }
  50% { height: 40%; }
  75% { height: 100%; }
}

@keyframes slide-in-from-left {
  0% { opacity: 0; transform: translateX(-20px); }
  100% { opacity: 1; transform: translateX(0); }
}

@keyframes feed-cycle {
  0%, 25% { opacity: 1; transform: translateY(0); }
  30%, 100% { opacity: 0; transform: translateY(-10px); }
}

@keyframes scroll-up-loop {
  0% { transform: translateY(0); }
  100% { transform: translateY(-50%); }
}

@keyframes pulse-border-marketing {
  0%, 100% { border-color: hsl(var(--primary) / 0.2); }
  50% { border-color: hsl(var(--primary) / 0.6); }
}

@keyframes flip-card {
  0% { transform: rotateY(0deg); }
  100% { transform: rotateY(180deg); }
}
