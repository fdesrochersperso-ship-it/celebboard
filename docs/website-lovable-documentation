### 7.2 AnimatedOnScroll

**File**: `src/components/Marketing/AnimatedOnScroll.tsx`

**Props**: `children: ReactNode`, `className?: string`, `delay?: number` (ms), `direction?: "up" | "left" | "right" | "scale"`

**Behavior**: Uses IntersectionObserver (threshold 0.15, rootMargin "0px 0px -50px 0px") to trigger a one-time fade+translate animation. Once visible, element stays visible.

```tsx
import { useEffect, useRef, useState, ReactNode } from "react";

interface AnimatedOnScrollProps {
  children: ReactNode;
  className?: string;
  delay?: number;
  direction?: "up" | "left" | "right" | "scale";
}

export const AnimatedOnScroll = ({
  children,
  className = "",
  delay = 0,
  direction = "up",
}: AnimatedOnScrollProps) => {
  const ref = useRef<HTMLDivElement>(null);
  const [isVisible, setIsVisible] = useState(false);

  useEffect(() => {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          setIsVisible(true);
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -50px 0px" }
    );
    if (ref.current) observer.observe(ref.current);
    return () => observer.disconnect();
  }, []);

  const transforms = {
    up: "translate-y-8",
    left: "translate-x-8",
    right: "-translate-x-8",
    scale: "scale-95",
  };

  return (
    <div
      ref={ref}
      className={`transition-all duration-700 ease-out ${
        isVisible ? "opacity-100 translate-y-0 translate-x-0 scale-100" : `opacity-0 ${transforms[direction]}`
      } ${className}`}
      style={{ transitionDelay: `${delay}ms` }}
    >
      {children}
    </div>
  );
};
```

